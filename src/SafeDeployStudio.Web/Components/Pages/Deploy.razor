@page "/deploy"
@inject IOrganizationRepository OrgRepo
@inject IProjectRepository ProjectRepo
@inject IDatabaseConnectionRepository ConnRepo
@inject IWorkflowService WorkflowService
@inject ISqlDiffEngine DiffEngine
@inject IGuardrailEngine GuardrailEngine
@inject IGuardrailPolicyRepository GuardrailRepo
@inject IAiAdvisorService AiAdvisor
@inject IDeploymentService DeploymentService

<PageTitle>SafeDeploy Studio - Deploy Studio</PageTitle>

<div style="margin-bottom: 1.5rem;">
    <h1 style="font-size: 1.5rem; font-weight: 700; margin: 0;">Deploy Studio</h1>
    <p style="color: var(--text-muted); margin: 0.25rem 0 0 0; font-size: 13px;">
        Guided 6-step transactional database migration with real-time diff, safety guardrails, and automated pre-change snapshots.
    </p>
</div>

<!-- 6-Step Stepper Header -->
<div class="stepper">
    <div class="step-node @(_currentStep == 1 ? "active" : (_currentStep > 1 ? "completed" : ""))" @onclick="() => SetStep(1)">
        <div class="step-circle">@(_currentStep > 1 ? "✓" : "1")</div>
        <span>1. Route</span>
    </div>
    <div class="step-line"></div>
    <div class="step-node @(_currentStep == 2 ? "active" : (_currentStep > 2 ? "completed" : ""))" @onclick="() => SetStep(2)">
        <div class="step-circle">@(_currentStep > 2 ? "✓" : "2")</div>
        <span>2. Procedure</span>
    </div>
    <div class="step-line"></div>
    <div class="step-node @(_currentStep == 3 ? "active" : (_currentStep > 3 ? "completed" : ""))" @onclick="() => SetStep(3)">
        <div class="step-circle">@(_currentStep > 3 ? "✓" : "3")</div>
        <span>3. Diff & AI</span>
    </div>
    <div class="step-line"></div>
    <div class="step-node @(_currentStep == 4 ? "active" : (_currentStep > 4 ? "completed" : ""))" @onclick="() => SetStep(4)">
        <div class="step-circle">@(_currentStep > 4 ? "✓" : "4")</div>
        <span>4. Pre-Flight</span>
    </div>
    <div class="step-line"></div>
    <div class="step-node @(_currentStep == 5 ? "active" : (_currentStep > 5 ? "completed" : ""))" @onclick="() => SetStep(5)">
        <div class="step-circle">@(_currentStep > 5 ? "✓" : "5")</div>
        <span>5. Dry-Run</span>
    </div>
    <div class="step-line"></div>
    <div class="step-node @(_currentStep == 6 ? "active" : (_currentStep > 6 ? "completed" : ""))" @onclick="() => SetStep(6)">
        <div class="step-circle">6</div>
        <span>6. Deploy</span>
    </div>
</div>

<!-- STEP 1: Route Selection -->
@if (_currentStep == 1)
{
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Step 1: Select Project & Migration Route</h2>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
            <div class="form-group">
                <label class="form-label">Project</label>
                <select class="form-select" @onchange="OnProjectChanged">
                    @foreach (var p in _projects)
                    {
                        <option value="@p.Id">@p.Name (@p.Slug)</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Deployment Title / Ticket</label>
                <input class="form-control" @bind="_deploymentTitle" placeholder="e.g. Migration: Update GetUserReport Stored Procedure" />
            </div>

            <div class="form-group">
                <label class="form-label">Source Environment (DEV / Authoring)</label>
                <select class="form-select" @bind="_selectedSourceEnvId">
                    @foreach (var env in _availableEnvironments)
                    {
                        <option value="@env.Id">@env.Name (@env.EnvironmentType)</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Target Environment (Sandbox / Stage / Prod)</label>
                <select class="form-select" @bind="_selectedTargetEnvId">
                    @foreach (var env in _availableEnvironments)
                    {
                        <option value="@env.Id">@env.Name (@env.EnvironmentType) @(env.IsProduction ? "[PROD PROTECTED]" : "")</option>
                    }
                </select>
            </div>
        </div>

        <div style="margin-top: 1.5rem; display: flex; justify-content: flex-end;">
            <button class="btn btn-primary" @onclick="() => SetStep(2)">
                Continue to Procedure Selection &rarr;
            </button>
        </div>
    </div>
}

<!-- STEP 2: Procedure Selection -->
@if (_currentStep == 2)
{
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Step 2: Select Stored Procedure or Paste SQL</h2>
            <button class="btn btn-secondary" style="font-size: 12px; padding: 0.3rem 0.6rem;" @onclick="LoadProcedures">
                @(_isLoadingProcedures ? "Loading..." : "🔄 Refresh Procedures")
            </button>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1rem;">
            <div class="form-group">
                <label class="form-label">Schema Name</label>
                <input class="form-control" @bind="_schemaName" placeholder="dbo" />
            </div>

            <div class="form-group">
                <label class="form-label">Procedure Name</label>
                <input class="form-control" @bind="_procedureName" placeholder="e.g. sp_GetCustomerActivity" />
            </div>
        </div>

        @if (_procedureList.Count > 0)
        {
            <div class="form-group">
                <label class="form-label">Or Pick From Discovered Procedures on Source Database (@_procedureList.Count items):</label>
                <select class="form-select" @onchange="OnProcedureSelectedFromList">
                    <option value="">-- Choose procedure from source database --</option>
                    @foreach (var p in _procedureList)
                    {
                        <option value="@p.ObjectName">[@p.SchemaName].[@p.ObjectName] (Modified: @p.LastModifiedUtc?.ToString("yyyy-MM-dd"))</option>
                    }
                </select>
            </div>
        }

        <div class="form-group">
            <label class="form-label">Source T-SQL Script (Auto-fetched or pasted):</label>
            <textarea class="form-control" rows="12" style="font-family: var(--font-mono); font-size: 12.5px;" @bind="_sourceScript" placeholder="CREATE OR ALTER PROCEDURE [dbo].[sp_MyProc] ..."></textarea>
        </div>

        <div style="margin-top: 1.5rem; display: flex; justify-content: space-between;">
            <button class="btn btn-secondary" @onclick="() => SetStep(1)">&larr; Back</button>
            <button class="btn btn-primary" @onclick="FetchAndCompare">Fetch Target & Compare &rarr;</button>
        </div>
    </div>
}

<!-- STEP 3: Diff & AI Analysis -->
@if (_currentStep == 3)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Step 3: SQL Diff & Performance Impact</h2>
                <div style="font-size: 12px; color: var(--text-muted);">
                    Comparing target vs source for <strong>[@_schemaName].[@_procedureName]</strong>
                </div>
            </div>
            <div>
                @if (_diffResult != null)
                {
                    <span class="badge badge-success" style="margin-right: 0.5rem;">+@_diffResult.AdditionsCount Additions</span>
                    <span class="badge badge-danger" style="margin-right: 0.5rem;">-@_diffResult.DeletionsCount Deletions</span>
                    <span class="badge badge-warning">~@_diffResult.ModificationsCount Changes</span>
                }
            </div>
        </div>

        @if (_aiResult != null)
        {
            <div style="background-color: var(--bg-card-hover); border-left: 4px solid var(--accent); border-radius: 4px; padding: 1rem; margin-bottom: 1.25rem;">
                <div style="font-weight: 600; font-size: 13px; color: var(--accent); margin-bottom: 0.35rem;">
                    💡 AI Advisor Performance Summary
                </div>
                <p style="margin: 0; font-size: 13px; color: var(--text-primary);">@_aiResult.Summary</p>
                <div style="margin-top: 0.5rem; font-size: 12px; color: var(--text-secondary);">
                    @_aiResult.PerformanceImpactAnalysis
                </div>
            </div>
        }

        <!-- Side-by-Side Diff Display -->
        <h4 style="font-size: 12.5px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem;">
            Unified Diff Stream
        </h4>
        <div class="diff-container">
            @if (_diffResult?.AllLines != null && _diffResult.AllLines.Count > 0)
            {
                @foreach (var line in _diffResult.AllLines)
                {
                    var lineClass = line.Type switch
                    {
                        DiffLineType.Inserted => "inserted",
                        DiffLineType.Deleted => "deleted",
                        DiffLineType.Modified => "modified",
                        _ => ""
                    };
                    <div class="diff-line @lineClass">
                        <div class="diff-line-number">@(line.OldLineNumber?.ToString() ?? "")</div>
                        <div class="diff-line-number">@(line.NewLineNumber?.ToString() ?? "")</div>
                        <div class="diff-line-content">
                            @(line.Type switch {
                                DiffLineType.Inserted => "+ ",
                                DiffLineType.Deleted => "- ",
                                DiffLineType.Modified => "~ ",
                                _ => "  "
                            })@line.Text
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="padding: 1.5rem; color: var(--text-muted); text-align: center;">
                    No differences detected or target procedure does not exist yet (clean addition).
                </div>
            }
        </div>

        <div style="margin-top: 1.5rem; display: flex; justify-content: space-between;">
            <button class="btn btn-secondary" @onclick="() => SetStep(2)">&larr; Back</button>
            <button class="btn btn-primary" @onclick="RunPreFlight">Continue to Pre-Flight Safety Gate &rarr;</button>
        </div>
    </div>
}

<!-- STEP 4: Pre-Flight Guardrail Check -->
@if (_currentStep == 4)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Step 4: Enterprise Pre-Flight Safety Verification</h2>
                <div style="font-size: 12px; color: var(--text-muted);">
                    Automated static analysis verifying DDL safety, ASCII encoding, and performance anti-patterns.
                </div>
            </div>
            <div>
                @if (_guardrailResult != null)
                {
                    <span class="badge @(_guardrailResult.IsValid ? "badge-success" : "badge-danger")" style="font-size: 12px;">
                        @(_guardrailResult.IsValid ? "✓ Guardrails Passed" : "✗ Guardrail Violations Found")
                    </span>
                }
            </div>
        </div>

        <!-- Rule Checklist -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
            <div style="background-color: var(--bg-card-hover); padding: 0.85rem; border-radius: 6px; border: 1px solid var(--border-color); display: flex; align-items: center; gap: 0.75rem;">
                <span style="color: var(--success); font-weight: bold; font-size: 16px;">✓</span>
                <div>
                    <div style="font-weight: 600; font-size: 13px;">Physical Table DDL Protection</div>
                    <div style="font-size: 11.5px; color: var(--text-muted);">DROP/TRUNCATE physical tables blocked. #temp tables permitted.</div>
                </div>
            </div>

            <div style="background-color: var(--bg-card-hover); padding: 0.85rem; border-radius: 6px; border: 1px solid var(--border-color); display: flex; align-items: center; gap: 0.75rem;">
                <span style="color: var(--success); font-weight: bold; font-size: 16px;">✓</span>
                <div>
                    <div style="font-weight: 600; font-size: 13px;">Forbidden Administrative Commands</div>
                    <div style="font-size: 11.5px; color: var(--text-muted);">xp_cmdshell, sp_configure, SHUTDOWN scans.</div>
                </div>
            </div>

            <div style="background-color: var(--bg-card-hover); padding: 0.85rem; border-radius: 6px; border: 1px solid var(--border-color); display: flex; align-items: center; gap: 0.75rem;">
                <span style="color: var(--success); font-weight: bold; font-size: 16px;">✓</span>
                <div>
                    <div style="font-weight: 600; font-size: 13px;">ASCII & BOM Compliance Gate</div>
                    <div style="font-size: 11.5px; color: var(--text-muted);">Smart quotes, non-standard dashes and non-ASCII characters.</div>
                </div>
            </div>

            <div style="background-color: var(--bg-card-hover); padding: 0.85rem; border-radius: 6px; border: 1px solid var(--border-color); display: flex; align-items: center; gap: 0.75rem;">
                <span style="color: var(--success); font-weight: bold; font-size: 16px;">✓</span>
                <div>
                    <div style="font-weight: 600; font-size: 13px;">Unqualified UPDATE / DELETE Trap</div>
                    <div style="font-size: 11.5px; color: var(--text-muted);">Missing WHERE clauses on bulk data updates.</div>
                </div>
            </div>
        </div>

        @if (_guardrailResult?.Violations != null && _guardrailResult.Violations.Count > 0)
        {
            <h4 style="font-size: 13px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem;">
                Flagged Guardrail Items (@_guardrailResult.Violations.Count)
            </h4>
            <div class="table-container" style="margin-bottom: 1.5rem;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Severity</th>
                            <th>Rule</th>
                            <th>Line</th>
                            <th>Message</th>
                            <th>Remediation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _guardrailResult.Violations)
                        {
                            <tr>
                                <td>
                                    <span class="badge @(v.Severity >= GuardrailSeverity.Error ? "badge-danger" : "badge-warning")">
                                        @v.Severity
                                    </span>
                                </td>
                                <td style="font-weight: 500;">@v.RuleName</td>
                                <td>@v.LineNumber</td>
                                <td>@v.Message</td>
                                <td style="color: var(--text-secondary); font-size: 12px;">@v.Remediation</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div style="margin-top: 1.5rem; display: flex; justify-content: space-between;">
            <button class="btn btn-secondary" @onclick="() => SetStep(3)">&larr; Back</button>
            <button class="btn btn-primary" disabled="@(!_guardrailResult?.IsValid ?? false)" @onclick="() => SetStep(5)">
                Continue to Sandbox Dry-Run &rarr;
            </button>
        </div>
    </div>
}

<!-- STEP 5: Sandbox Dry-Run -->
@if (_currentStep == 5)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Step 5: Transactional Sandbox Dry-Run</h2>
                <div style="font-size: 12px; color: var(--text-muted);">
                    Executes the migration within a transaction on the target database and verifies clean automatic rollback.
                </div>
            </div>
        </div>

        <div style="background-color: var(--bg-card-hover); border-radius: 6px; padding: 1.25rem; margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3 style="margin: 0; font-size: 14px;">Target Sandbox Test</h3>
                    <p style="margin: 0.25rem 0 0 0; font-size: 12px; color: var(--text-muted);">
                        Zero side effects. Validates foreign keys, column references, permissions, and SQL syntax against the real target schema.
                    </p>
                </div>
                <button class="btn btn-primary" disabled="@_isRunningDryRun" @onclick="ExecuteDryRun">
                    @(_isRunningDryRun ? "Executing Dry-Run..." : "⚡ Run Sandbox Dry-Run Now")
                </button>
            </div>
        </div>

        @if (_dryRunResult != null)
        {
            <div style="margin-bottom: 1.25rem; padding: 1rem; border-radius: 6px; background-color: @(_dryRunResult.IsSuccessful ? "var(--success-bg)" : "var(--danger-bg)"); border: 1px solid @(_dryRunResult.IsSuccessful ? "var(--success)" : "var(--danger)");">
                <div style="font-weight: 600; font-size: 14px; color: @(_dryRunResult.IsSuccessful ? "var(--success)" : "var(--danger)");">
                    @(_dryRunResult.IsSuccessful ? "✓ Sandbox Dry-Run Passed Cleanly" : "✗ Sandbox Dry-Run Execution Failed")
                </div>
                <div style="font-size: 12.5px; margin-top: 0.35rem;">
                    Duration: @_dryRunResult.ExecutionDurationMs ms | Rollback Verified: @(_dryRunResult.RolledBackCleanly ? "Yes" : "No")
                </div>
                @if (!string.IsNullOrWhiteSpace(_dryRunResult.ErrorMessage))
                {
                    <div style="margin-top: 0.5rem; color: var(--danger); font-family: var(--font-mono); font-size: 12px;">
                        @_dryRunResult.ErrorMessage
                    </div>
                }
            </div>

            <div class="terminal-box" style="margin-bottom: 1.5rem;">
                @foreach (var msg in _dryRunResult.Messages)
                {
                    <div>@msg</div>
                }
            </div>
        }

        <div style="margin-top: 1.5rem; display: flex; justify-content: space-between;">
            <button class="btn btn-secondary" @onclick="() => SetStep(4)">&larr; Back</button>
            <button class="btn btn-primary" disabled="@(!(_dryRunResult?.IsSuccessful ?? false))" @onclick="() => SetStep(6)">
                Proceed to Live Deployment &rarr;
            </button>
        </div>
    </div>
}

<!-- STEP 6: Live Deployment & Backup -->
@if (_currentStep == 6)
{
    <div class="card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Step 6: Live Deployment & Vault Pre-Change Snapshot</h2>
                <div style="font-size: 12px; color: var(--text-muted);">
                    A timestamped SHA-256 backup snapshot will be recorded in the Vault prior to applying changes.
                </div>
            </div>
        </div>

        <div style="background-color: var(--bg-card-hover); border-radius: 6px; padding: 1.25rem; margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h3 style="margin: 0; font-size: 14px; color: var(--warning);">Ready to Deploy to Target</h3>
                    <p style="margin: 0.25rem 0 0 0; font-size: 12px; color: var(--text-muted);">
                        Deployment Title: <strong>@_deploymentTitle</strong>
                    </p>
                </div>
                <button class="btn btn-success" disabled="@_isDeploying" @onclick="ExecuteLiveDeployment">
                    @(_isDeploying ? "Deploying..." : "🚀 Execute Deployment")
                </button>
            </div>
        </div>

        <h4 style="font-size: 12.5px; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem;">
            Real-Time Deployment Console
        </h4>
        <div class="terminal-box" style="margin-bottom: 1.5rem;">
            @if (_liveLogs.Count == 0)
            {
                <div style="color: var(--text-muted);">Awaiting deployment trigger...</div>
            }
            else
            {
                @foreach (var log in _liveLogs)
                {
                    <div>@log</div>
                }
            }
        </div>

        @if (_completedRecord != null)
        {
            <div style="padding: 1.25rem; border-radius: 6px; background-color: @(_completedRecord.Status == DeploymentStatus.Succeeded ? "var(--success-bg)" : "var(--danger-bg)"); border: 1px solid @(_completedRecord.Status == DeploymentStatus.Succeeded ? "var(--success)" : "var(--danger)"); display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <div style="font-weight: 700; font-size: 15px; color: @(_completedRecord.Status == DeploymentStatus.Succeeded ? "var(--success)" : "var(--danger)");">
                        @(_completedRecord.Status == DeploymentStatus.Succeeded ? "✓ Deployment Succeeded" : "✗ Deployment Failed")
                    </div>
                    <div style="font-size: 12px; margin-top: 0.25rem;">
                        Duration: @_completedRecord.ExecutionDurationMs ms | Snapshot ID: @(_completedRecord.BackupSnapshotId?.ToString() ?? "None")
                    </div>
                </div>
                <div>
                    <a href="history" class="btn btn-secondary" style="font-size: 12.5px;">View in Audit History</a>
                </div>
            </div>
        }

        <div style="margin-top: 1.5rem; display: flex; justify-content: flex-start;">
            <button class="btn btn-secondary" @onclick="() => SetStep(5)">&larr; Back</button>
        </div>
    </div>
}

@code {
    private int _currentStep = 1;
    private List<Project> _projects = [];
    private Project? _selectedProject;
    private List<EnvironmentDefinition> _availableEnvironments = [];
    private Guid _selectedSourceEnvId;
    private Guid _selectedTargetEnvId;
    private string _deploymentTitle = "Migration: Stored Procedure Update";

    private string _schemaName = "dbo";
    private string _procedureName = "";
    private string _sourceScript = "";
    private string _targetScript = "";

    private List<SchemaObjectInfo> _procedureList = [];
    private bool _isLoadingProcedures = false;

    private SqlDiffResult? _diffResult;
    private AiAnalysisResult? _aiResult;
    private GuardrailResult? _guardrailResult;
    private DryRunExecutionResult? _dryRunResult;
    private bool _isRunningDryRun = false;

    private List<string> _liveLogs = [];
    private bool _isDeploying = false;
    private DeploymentRecord? _completedRecord;

    protected override async Task OnInitializedAsync()
    {
        var orgs = await OrgRepo.GetAllAsync();
        _projects = orgs.SelectMany(o => o.Projects).ToList();

        if (_projects.Count > 0)
        {
            _selectedProject = await ProjectRepo.GetByIdAsync(_projects[0].Id);
            if (_selectedProject != null)
            {
                _availableEnvironments = _selectedProject.Environments.OrderBy(x => x.OrderIndex).ToList();
                if (_availableEnvironments.Count >= 2)
                {
                    _selectedSourceEnvId = _availableEnvironments[0].Id;
                    _selectedTargetEnvId = _availableEnvironments[1].Id;
                }
            }
        }
    }

    private void SetStep(int step)
    {
        _currentStep = step;
    }

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var pId))
        {
            _selectedProject = await ProjectRepo.GetByIdAsync(pId);
            if (_selectedProject != null)
            {
                _availableEnvironments = _selectedProject.Environments.OrderBy(x => x.OrderIndex).ToList();
                if (_availableEnvironments.Count >= 2)
                {
                    _selectedSourceEnvId = _availableEnvironments[0].Id;
                    _selectedTargetEnvId = _availableEnvironments[1].Id;
                }
            }
        }
    }

    private async Task LoadProcedures()
    {
        if (_selectedProject == null) return;
        var sourceEnv = _selectedProject.Environments.FirstOrDefault(e => e.Id == _selectedSourceEnvId);
        if (sourceEnv?.DatabaseConnectionId == null) return;

        _isLoadingProcedures = true;
        try
        {
            _procedureList = (await WorkflowService.ListProceduresAsync(sourceEnv.DatabaseConnectionId.Value)).ToList();
        }
        finally
        {
            _isLoadingProcedures = false;
        }
    }

    private void OnProcedureSelectedFromList(ChangeEventArgs e)
    {
        var selectedName = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(selectedName))
        {
            var match = _procedureList.FirstOrDefault(p => p.ObjectName == selectedName);
            if (match != null)
            {
                _schemaName = match.SchemaName;
                _procedureName = match.ObjectName;
            }
        }
    }

    private async Task FetchAndCompare()
    {
        if (_selectedProject == null) return;

        var sourceEnv = _selectedProject.Environments.FirstOrDefault(e => e.Id == _selectedSourceEnvId);
        var targetEnv = _selectedProject.Environments.FirstOrDefault(e => e.Id == _selectedTargetEnvId);

        if (sourceEnv?.DatabaseConnectionId == null || targetEnv?.DatabaseConnectionId == null)
            return;

        var targetConn = await ConnRepo.GetByIdAsync(targetEnv.DatabaseConnectionId.Value);
        if (targetConn != null)
        {
            // If sourceScript is empty, fetch from source connection
            if (string.IsNullOrWhiteSpace(_sourceScript))
            {
                var sourceConn = await ConnRepo.GetByIdAsync(sourceEnv.DatabaseConnectionId.Value);
                if (sourceConn != null)
                {
                    var provider = DeploymentService; // provider
                }
            }
        }

        // Run diff comparison
        _diffResult = DiffEngine.CompareSql(_targetScript, _sourceScript, _procedureName, _schemaName);

        // Run AI advisor
        _aiResult = await AiAdvisor.AnalyzeProcedureMigrationAsync(
            _targetScript,
            _sourceScript,
            new AiProviderSettings());

        SetStep(3);
    }

    private async Task RunPreFlight()
    {
        if (_selectedProject == null) return;

        var policy = await GuardrailRepo.GetByProjectIdAsync(_selectedProject.Id)
                     ?? new GuardrailPolicy(_selectedProject.Id, "Default Policy");

        _guardrailResult = await GuardrailEngine.ValidateScriptAsync(_sourceScript, policy);
        SetStep(4);
    }

    private async Task ExecuteDryRun()
    {
        if (_selectedProject == null) return;
        var targetEnv = _selectedProject.Environments.FirstOrDefault(e => e.Id == _selectedTargetEnvId);
        if (targetEnv?.DatabaseConnectionId == null) return;

        var targetConn = await ConnRepo.GetByIdAsync(targetEnv.DatabaseConnectionId.Value);
        if (targetConn == null) return;

        _isRunningDryRun = true;
        _dryRunResult = null;
        StateHasChanged();

        try
        {
            var objects = new List<DeploymentObject>
            {
                new(Guid.Empty, _schemaName, _procedureName, DatabaseObjectType.StoredProcedure, _sourceScript)
            };

            _dryRunResult = await DeploymentService.RunSandboxDryRunAsync(targetConn, objects);
        }
        finally
        {
            _isRunningDryRun = false;
        }
    }

    private async Task ExecuteLiveDeployment()
    {
        if (_selectedProject == null) return;
        var sourceEnv = _selectedProject.Environments.FirstOrDefault(e => e.Id == _selectedSourceEnvId);
        var targetEnv = _selectedProject.Environments.FirstOrDefault(e => e.Id == _selectedTargetEnvId);
        if (sourceEnv == null || targetEnv?.DatabaseConnectionId == null) return;

        var targetConn = await ConnRepo.GetByIdAsync(targetEnv.DatabaseConnectionId.Value);
        if (targetConn == null) return;

        _isDeploying = true;
        _liveLogs.Clear();
        StateHasChanged();

        var objects = new List<DeploymentObject>
        {
            new(Guid.Empty, _schemaName, _procedureName, DatabaseObjectType.StoredProcedure, _sourceScript)
        };

        try
        {
            _completedRecord = await DeploymentService.ExecuteDeploymentAsync(
                _selectedProject,
                sourceEnv,
                targetEnv,
                targetConn,
                objects,
                _deploymentTitle,
                createdBy: "developer",
                logCallback: msg =>
                {
                    _liveLogs.Add(msg);
                    InvokeAsync(StateHasChanged);
                });
        }
        finally
        {
            _isDeploying = false;
        }
    }
}
